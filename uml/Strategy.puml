@startuml
'https://plantuml.com/class-diagram

interface ShootStrategy {
    + doShoot(locationX:int, locationY:int, speedX:int, speedY:int, direction:int, power:int, shootNum:int): List<BaseBullet>
}

class DirectShoot {
    + doShoot(locationX:int, locationY:int, speedX:int, speedY:int, direction:int, power:int, shootNum:int): List<BaseBullet>
}

class ScatterShoot {
    + doShoot(locationX:int, locationY:int, speedX:int, speedY:int, direction:int, power:int, shootNum:int): List<BaseBullet>
}

ShootStrategy <|.. DirectShoot
ShootStrategy <|.. ScatterShoot

abstract class AbstractAircraft {
    # maxHp:int
    # hp:int
    # strategy: ShootStrategy
    + AbstractAircraft(int locationX, int locationY, int speedX, int speedY, int hp)
    + setShootStrategy(strategy: ShootStrategy): void
    + shoot(): List<BaseBullet>
}

class HeroAircraft {
    - shootNum:int
    - power:int
    - direction:int
    + HeroAircraft(...)
    + shoot(): List<BaseBullet>
}

class MobEnemy {
    + shoot(): List<BaseBullet>
}

class EliteEnemy {
    + shoot(): List<BaseBullet>
}

AbstractAircraft <|-- HeroAircraft
AbstractAircraft <|-- MobEnemy
AbstractAircraft <|-- EliteEnemy

AbstractAircraft o--> ShootStrategy

@enduml