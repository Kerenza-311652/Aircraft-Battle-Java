@startuml
'https://plantuml.com/class-diagram



class RecordDaoImpl <<DaoImpl>> {
    - records : List<Record>
    + getAllRecords() : List<Record>
    + doAdd(record : Record) : void
}

class Record <<ValueObject>> {
    - pName : String
    - score : int
    - recordTime : String
    + Record(pName:String, score:int, recordTime:String)
    + getPName() : String
    + getScore() : int
}

interface RecordDao <<DataAccessObject>> {
    + getAllRecords() : List<Record>
    + doAdd(record : Record) : void
}

class Game <<Client>> {
    - recordDao : RecordDao
    + gameOver() : void
}

Game -right-> RecordDao

RecordDaoImpl -up.|> RecordDao

RecordDaoImpl -left-> Record

@enduml