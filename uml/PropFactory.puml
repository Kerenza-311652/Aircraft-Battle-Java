@startuml
'https://plantuml.com/class-diagram

skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50

package "产品 " {

    abstract class AbstractProp {
        + AbstractProp(int locationX, int locationY, int speedX, int speedY)
        + forward():void
        + {abstract} active():void
    }

    class BloodProp {
        + BloodProp(int locationX, int locationY, int speedX, int speedY)
        + active():void
    }

    class FireProp {
        + FireProp(int locationX, int locationY, int speedX, int speedY)
        + active():void
    }

    class SuperFireProp {
        + SuperFireProp(int locationX, int locationY, int speedX, int speedY)
        + active():void
    }

    class BombProp {
        + BombProp(int locationX, int locationY, int speedX, int speedY)
        + active():void
    }

    class FreezeProp {
        + FreezeProp(int locationX, int locationY, int speedX, int speedY)
        + active():void
    }

    AbstractProp <|-- BloodProp
    AbstractProp <|-- FireProp
    AbstractProp <|-- SuperFireProp
    AbstractProp <|-- BombProp
    AbstractProp <|-- FreezeProp
}

package "简单工厂" {
    class PropFactory {
        + {static} createProp(propType:String, locationX:int, locationY:int, speedX:int, speedY:int):AbstractProp
    }

    note bottom of PropFactory
      switch (propType) {
        case "Blood":
            return new BloodProp(...);
        case "Fire":
            return new FireProp(...);
        case "SuperFire":
            return new SuperFireProp(...);
        default:
            return null;
      }
    end note
}

PropFactory .right.> AbstractProp

@enduml